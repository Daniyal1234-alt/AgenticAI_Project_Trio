# =============================================================================
# Agentic AI — Animated Video Generation System
# =============================================================================
# Every setting is OPTIONAL — the project runs end-to-end with no API keys
# (it falls back to a deterministic stub story + placeholder images + free
# edge-tts voices). Filling these in makes the output noticeably better.

# ---------- LLM (Phase 1 story generation + Phase 5 edit-intent agent) -------
# When set, Phase 1 calls gpt-4o-mini for richer stories and Phase 5 uses the
# LLM to classify edit intents. When unset, both phases use rule-based stubs.
OPENAI_API_KEY=

# ---------- Image generation (Phase 3) ---------------------------------------
# IMAGE_BACKEND=auto        # auto = try sdxl → openai → placeholder (default)
#                           # sdxl = local Stable Diffusion (needs torch+diffusers)
#                           # openai = DALL-E 3 (needs OPENAI_API_KEY)
#                           # placeholder = PIL stylised stills (no deps)
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1792x1024

# ---------- Phase 3 — Kaggle remote inference (optional) ---------------------
# Base URL of your Kaggle FastAPI server (see docs/kaggle_setup.md).
# When set, SVD ambient motion + Wav2Lip lip-sync run remotely. When unset,
# the local pipeline falls back to FFmpeg-only passthrough clips.
# KAGGLE_ENDPOINT=https://your-ngrok-url.ngrok-free.app

# ---------- Phase 3 fonts ----------------------------------------------------
# Path to a TrueType font used for scene title cards. If unset, the renderer
# auto-detects Segoe UI / Helvetica / DejaVu Sans depending on platform.
# PHASE3_FONT=C:/Windows/Fonts/seguisb.ttf
